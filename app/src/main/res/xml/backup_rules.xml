<?xml version="1.0" encoding="utf-8"?>
<!--
   Copias de seguridad (Android 11 o anterior).
   La base de datos guarda las cuentas (hash de contraseñas) y la sesión,
   así que no se copian fuera del teléfono.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
