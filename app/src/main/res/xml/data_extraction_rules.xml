<?xml version="1.0" encoding="utf-8"?>
<!--
   Copias de seguridad y traspaso a otro teléfono (Android 12 o superior).
   La base de datos (cuentas, predios) y la sesión no salen del teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
